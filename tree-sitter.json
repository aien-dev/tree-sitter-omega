{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "omega",
      "camelcase": "Omega",
      "title": "Omega",
      "scope": "source.omega",
      "file-types": [
        "om"
      ],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^(omega|om|omegese)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0 WITH LLVM-exception",
    "description": "Omega (.om, Omegese) grammar for tree-sitter",
    "authors": [
      {
        "name": "Drake Stapleton",
        "email": "drake@aienos.com"
      }
    ],
    "links": {
      "repository": "https://github.com/aien-dev/tree-sitter-omega"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
